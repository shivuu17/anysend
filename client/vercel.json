{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://anysend-hrvy.onrender.com/"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://anysend-hrvy.onrender.com/"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://anysend-hrvy.onrender.com/uploads/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
